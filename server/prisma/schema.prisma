generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// --- UTILISATEURS (ADMIN & JURY) ---
// -----------------------------------------------------------------------------
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String?   
  firstName     String
  lastName      String
  
  /// Bio du juré pour présentation officielle sur la plateforme
  bio           String?   @db.Text
  
  role          Role      @default(JURY)
  
  loginToken    String?   @unique
  tokenExpires  DateTime?
  lastLogin     DateTime? 

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  votes         Vote[]

  @@map("users")
}

enum Role {
  ADMIN
  JURY
}

// -----------------------------------------------------------------------------
// --- ARTISTES (SUBMITTERS) ---
// -----------------------------------------------------------------------------
model Submitter {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  firstName     String?
  lastName      String?
  
  /// Bio de l'artiste (Text long)
  bio           String?   @db.Text
  website       String?
  instagram     String?

  /// Système Passwordless pour modification de la fiche et des films
  loginToken    String?   @unique
  tokenExpires  DateTime?

  films         Film[]

  @@map("submitters")
}

// -----------------------------------------------------------------------------
// --- FILMS (L'ŒUVRE & SES VERSIONS) ---
// -----------------------------------------------------------------------------
model Film {
  id               Int           @id @default(autoincrement())
  submitterId      Int
  submissionToken  String        @unique @default(uuid())

  title            String
  description      String        @db.Text
  country          String
  language         String?       
  
  /// Transparence IA : Liste des outils
  aiStack          String        @db.Text
  aiMethodologyUrl String?       @db.Text

  // --- GESTION DES FICHIERS (S3 / MINIO) ---
  s3VideoKey       String?    
  s3VideoUrl       String?    
  posterUrl        String?       @db.Text
  subtitleUrl      String?       @db.Text
  
  // YouTube Information
  youtubeVideoId    String?         @unique
  youtubeUrl        String?
  youtubeStatus     YoutubeStatus?  @default(PENDING)
  youtubeUploadedAt DateTime?
  youtubeModerationData Json?

  // Video Metadata
  videoDuration      Float?
  videoFormat        String?
  videoSize          Int?
  videoWidth         Int?
  videoHeight        Int?
  videoCodec         String?

  // --- WORKFLOW & SELECTION ---
  status           FilmStatus @default(PENDING)
  
  averageRating    Float?
  totalVotes       Int        @default(0)

  submittedAt      DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations
  submitter        Submitter     @relation(fields: [submitterId], references: [id])
  votes            Vote[]
  awards           Award[]
  
  /// Historique des modifications apportées par l'artiste
  versions         FilmVersion[]

  @@index([status])
  @@index([youtubeStatus])
  @@index([country])
  @@index([averageRating])
  @@map("films")
}

model FilmVersion {
  id          Int      @id @default(autoincrement())
  filmId      Int
  
  /// Snapshot des données avant modification
  title       String
  description String   @db.Text
  aiStack     String   @db.Text
  s3VideoKey  String?
  youtubeUrl  String?
  
  archivedAt  DateTime @default(now())

  film        Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@index([filmId])
  @@map("film_versions")
}

enum FilmStatus {
  PENDING
  APPROVED
  SELECTION
  FINALIST
  REJECTED
  TO_MODIFY
}

enum YoutubeStatus {
  PENDING
  UPLOADING
  PROCESSING
  APPROVED
  REJECTED
  EXPLICIT_CONTENT
  VIOLENCE
  FAILED
}

// -----------------------------------------------------------------------------
// --- VOTES & DIALOGUE CRITIQUE ---
// -----------------------------------------------------------------------------
model Vote {
  id          Int             @id @default(autoincrement())
  filmId      Int
  userId      Int

  decision    VoteDecision
  rating      Int             // Note quantitative 0-10
  
  votedAt     DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  film        Film            @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fil de discussion critique (multiples commentaires datés)
  comments    ReviewComment[]

  @@unique([filmId, userId])
  @@map("votes")
}

model ReviewComment {
  id          Int      @id @default(autoincrement())
  voteId      Int
  
  content     String   @db.Text
  
  /// Si true : visible uniquement par Admin/Jury. Si false : transmis à l'artiste.
  isInternal  Boolean  @default(true)
  
  createdAt   DateTime @default(now())

  vote        Vote     @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@index([voteId])
  @@map("review_comments")
}

enum VoteDecision {
  APPROVE
  REJECT
  TO_MODIFY
}

// -----------------------------------------------------------------------------
// --- PALMARÈS & NEWSLETTER ---
// -----------------------------------------------------------------------------
model Award {
  id          Int      @id @default(autoincrement())
  name        String   
  description String?  @db.Text
  
  filmId      Int?     
  film        Film?    @relation(fields: [filmId], references: [id])

  @@map("awards")
}

model NewsletterSubscriber {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  unsubscribeToken  String   @unique @default(uuid())
  subscribedAt      DateTime @default(now())

  @@map("newsletter_subscribers")
}
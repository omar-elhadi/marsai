generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

/// Rôles utilisateurs — hiérarchie : ADMIN > MODERATOR > JURY
enum Role {
  ADMIN // Contrôle total (Bruno, Jules)
  MODERATOR // Gestion films uniquement, pas les jurys
  JURY // Vote sur films assignés uniquement
}

/// Workflow statuts films — machine d'états stricte (voir CLAUDE.md §8)
enum FilmStatus {
  SUBMITTED // Film reçu (anciennement PENDING)
  IN_REVIEW // Jurys assignés, évaluation en cours
  APPROVED // Validé par admin/moderator
  REJECTED // Refusé — statut final
  TO_MODIFY // Modifications demandées au réalisateur
  SELECTION // Sélection officielle top 50-70
  FINALIST // Nominé dans une catégorie Award
  AWARD // Gagnant d'une catégorie — statut final
}

/// Sentiment du jury — jury = conseiller, admin = décideur final
enum VoteSentiment {
  LIKE
  DISLIKE
}

/// Statut pipeline upload YouTube (Phase 4)
enum YoutubeStatus {
  PENDING
  UPLOADING
  PROCESSING
  APPROVED
  REJECTED
  EXPLICIT_CONTENT
  VIOLENCE
  FAILED
}

// -----------------------------------------------------------------------------
// UTILISATEURS (ADMIN, MODERATOR, JURY)
// -----------------------------------------------------------------------------

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String? // Nullable — jurys se connectent via magic link uniquement
  firstName String
  lastName  String
  bio       String? @db.Text
  photoUrl  String?

  role Role @default(JURY)

  /// Token magic link (usage unique, invalidé après connexion)
  loginToken   String?   @unique
  tokenExpires DateTime?
  lastLogin    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  votes           Vote[]
  statusHistories FilmStatusHistory[]
  /// Films assignés à ce jury (many-to-many via table pivot _FilmAssignments)
  assignedFilms   Film[]              @relation("FilmAssignments")

  @@map("users")
}

// -----------------------------------------------------------------------------
// RÉALISATEURS (SUBMITTERS)
// -----------------------------------------------------------------------------

model Submitter {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  firstName String?
  lastName  String?
  bio       String? @db.Text
  website   String?
  instagram String?

  /// Token passwordless pour édition film en cas de TO_MODIFY (7 jours)
  loginToken   String?   @unique
  tokenExpires DateTime?

  films Film[]

  @@map("submitters")
}

// -----------------------------------------------------------------------------
// FILMS
// -----------------------------------------------------------------------------

model Film {
  id              Int    @id @default(autoincrement())
  submitterId     Int
  submissionToken String @unique @default(uuid())

  // --- Informations de base ---
  title       String
  description String  @db.Text
  country     String
  language    String?
  posterUrl   String?
  subtitleUrl String?

  // --- Transparence IA ---
  aiToolsUsed      String  @db.Text
  aiMethodologyUrl String? @db.Text

  // --- Vidéo (YouTube URL manuelle Phase 1-3, upload S3+YouTube Phase 4) ---
  youtubeUrl        String?
  youtubeVideoId    String?
  youtubeStatus     YoutubeStatus?
  youtubeUploadedAt DateTime?
  s3VideoKey        String?
  videoDuration     Float?
  videoFormat       String?
  videoSize         Int?
  videoWidth        Int?
  videoHeight       Int?
  videoCodec        String?

  // --- Workflow & statut ---
  status FilmStatus @default(SUBMITTED)

  // --- Stats votes (dénormalisées pour performance dashboard) ---
  avgRating     Float? // Recalculé après chaque vote
  totalVotes    Int    @default(0)
  totalLikes    Int    @default(0)
  totalDislikes Int    @default(0)

  // --- Workflow TO_MODIFY ---
  /// Message de l'admin expliquant les modifications demandées
  modificationRequest     String?   @db.Text
  modificationRequestedAt DateTime?
  /// ID de l'admin/moderator qui a fait la demande
  modificationRequestedBy Int?

  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete

  // Audits statuts
  approvedBy Int? // User (Admin/Mod) ID
  approvedAt DateTime?
  rejectedBy Int? // User (Admin/Mod) ID
  rejectedAt DateTime?

  // --- Relations ---
  submitter       Submitter           @relation(fields: [submitterId], references: [id])
  /// Jurys assignés à ce film (many-to-many — bloqué si votes déjà commencés)
  assignedUsers   User[]              @relation("FilmAssignments")
  votes           Vote[]
  versions        FilmVersion[]
  statusHistories FilmStatusHistory[]
  nominations     FilmNomination[]

  @@index([status])
  @@index([country])
  @@index([avgRating])
  @@index([youtubeStatus])
  @@map("films")
}

// -----------------------------------------------------------------------------
// HISTORIQUE MODIFICATIONS (TO_MODIFY)
// -----------------------------------------------------------------------------

model FilmVersion {
  id     Int @id @default(autoincrement())
  filmId Int

  /// Snapshot du film avant modification — permet comparaison versions
  title       String
  description String  @db.Text
  aiToolsUsed String  @db.Text
  posterUrl   String?
  youtubeUrl  String?
  s3VideoKey  String?

  archivedAt DateTime @default(now())

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@index([filmId])
  @@map("film_versions")
}

// -----------------------------------------------------------------------------
// VOTES JURYS
// -----------------------------------------------------------------------------

model Vote {
  id     Int @id @default(autoincrement())
  filmId Int
  userId Int

  /// Avis du jury — LIKE ou DISLIKE (jury = conseiller, pas décideur)
  sentiment           VoteSentiment
  /// Note qualitative 0-10
  rating              Int
  /// Si true, le jury suggère des modifications (commentaire obligatoire)
  suggestModification Boolean       @default(false)

  votedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  film     Film            @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments ReviewComment[]

  /// Contrainte : 1 jury = 1 vote par film (upsert pour modification)
  @@unique([filmId, userId])
  @@index([filmId])
  @@index([userId])
  @@map("votes")
}

// -----------------------------------------------------------------------------
// COMMENTAIRES CRITIQUES
// -----------------------------------------------------------------------------

model ReviewComment {
  id         Int      @id @default(autoincrement())
  voteId     Int
  content    String   @db.Text
  /// true = visible admin+jury uniquement / false = transmis au réalisateur
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  vote Vote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@index([voteId])
  @@map("review_comments")
}

// -----------------------------------------------------------------------------
// PALMARÈS — Catégories + Nominations multi-éditions
// -----------------------------------------------------------------------------

/// Catégorie de prix par édition — créée librement par l'admin
model AwardCategory {
  id           Int     @id @default(autoincrement())
  /// Année de l'édition (2026, 2027…)
  edition      Int
  /// Nom libre : "Meilleur film IA", "Coup de cœur", etc.
  name         String
  description  String? @db.Text
  /// Ordre d'affichage sur la page palmarès
  displayOrder Int     @default(0)

  nominations FilmNomination[]

  @@index([edition])
  @@map("award_categories")
}

/// Nomination d'un film dans une catégorie — isWinner=true pour le gagnant
model FilmNomination {
  id         Int     @id @default(autoincrement())
  filmId     Int
  categoryId Int
  /// true = gagnant de la catégorie (un seul par catégorie)
  isWinner   Boolean @default(false)

  film     Film          @relation(fields: [filmId], references: [id], onDelete: Cascade)
  category AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Un film ne peut être nominé qu'une seule fois par catégorie
  @@unique([filmId, categoryId])
  @@index([filmId])
  @@index([categoryId])
  @@map("film_nominations")
}

// -----------------------------------------------------------------------------
// PAGE JURY PUBLIQUE (affichage statique — pas lié à User)
// -----------------------------------------------------------------------------

model JuryMember {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  /// Titre/fonction (ex: "Réalisatrice", "Directrice artistique")
  title        String
  bio          String  @db.Text
  photoUrl     String?
  displayOrder Int     @default(0)
  website      String?
  instagram    String?
  twitter      String?

  @@map("jury_members")
}

// -----------------------------------------------------------------------------
// SETTINGS SITE (admin)
// -----------------------------------------------------------------------------

model SiteSettings {
  id            Int      @id @default(autoincrement())
  currentYear   Int      @default(2026)
  festivalTheme String?
  festivalDates String?
  trailerUrl    String?
  heroImageUrl  String?
  aboutText     String?  @db.Text
  rulesText     String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

// -----------------------------------------------------------------------------
// NEWSLETTER
// -----------------------------------------------------------------------------

model NewsletterSubscriber {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  unsubscribeToken String   @unique @default(uuid())
  subscribedAt     DateTime @default(now())

  @@map("newsletter_subscribers")
}

// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------
model FilmStatusHistory {
  id         Int        @id @default(autoincrement())
  filmId     Int
  film       Film       @relation(fields: [filmId], references: [id], onDelete: Cascade)
  fromStatus FilmStatus
  toStatus   FilmStatus
  changedBy  Int? // User ID of the admin/mod who changed it, null if system
  user       User?      @relation(fields: [changedBy], references: [id], onDelete: SetNull)
  changedAt  DateTime   @default(now())
  comment    String?    @db.Text

  @@index([filmId])
  @@index([changedBy])
  @@map("film_status_history")
}

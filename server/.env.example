DATABASE_URL=mysql://[username]:[password]@localhost/marsai

# JWT Secret
JWT_SECRET=votre_cle_de_64_caracteres_ici

# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# YouTube Data API v3 Configuration
# Guide de configuration : https://developers.google.com/youtube/v3/getting-started
# 1. Créer un projet sur Google Cloud Console
# 2. Activer YouTube Data API v3
# 3. Créer des credentials OAuth 2.0 ET une clé API

# Clé API YouTube (pour opérations de lecture publique)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OAuth 2.0 Credentials (pour uploads de vidéos)
YOUTUBE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxx
YOUTUBE_REDIRECT_URI=http://localhost:5001/api/youtube/callback

# Refresh Token (obtenu après première authentification OAuth)
# Générer avec : node src/utils/generate-youtube-token.js
YOUTUBE_REFRESH_TOKEN=xxxxxx

# Scaleway S3 Credentials (Replace with your own credentials)
SCALEWAY_ACCESS_KEY=your_scaleway_access_key_here
SCALEWAY_SECRET_KEY=your_scaleway_secret_key_here
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud
SCALEWAY_BUCKET_NAME=your_bucket_name
SCALEWAY_REGION=fr-par
SCALEWAY_FOLDER=your_folder_name
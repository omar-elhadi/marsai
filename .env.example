# Database Configuration
DATABASE_URL=mysql://root:root@db:3306/marsai
DB_PASSWORD=root

# API Configuration
PORT=5000
NODE_ENV=development

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-32-characters

# Email Configuration (SMTP)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=testuser
MAIL_PASS=testpass

# Scaleway S3 Configuration (or any S3-compatible storage)
SCALEWAY_ENDPOINT=s3.nl-ams.scw.cloud
SCALEWAY_REGION=nl-ams
SCALEWAY_BUCKET_NAME=your-bucket-name
SCALEWAY_FOLDER=videos
SCALEWAY_ACCESS_KEY=your-access-key
SCALEWAY_SECRET_KEY=your-secret-key

# Optional: YouTube API Integration (Phase 4+)
# YOUTUBE_API_KEY=your-youtube-api-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# Optional: Feature flags
# USE_MOCK_DATA=true
# DEBUG_MODE=false
